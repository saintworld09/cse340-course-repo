<%- include('partials/header') %>


<main class="project-details-page">

    <div class="project-top-actions">
        
        <a href="/edit-project/<%= project.project_id %>" class="btn-primary-action">
             Edit Project
        </a>

        <a href="/assign-categories/<%= project.project_id %>" class="btn-secondary-action">
             Edit Categories
        </a> 
    </div>

    <div class="project-details-card">

        <h1 class="project-title"><%= project.title %></h1>

        <% if (isLoggedIn) { %>

    <div class="volunteer-section">

        <% if (!volunteerStatus) { %>

            <form
                action="/volunteer/<%= project.project_id %>"
                method="POST">

                <button
                    type="submit"
                    class="volunteer-btn">

                    Volunteer For This Project

                </button>

            </form>

        <% } else { %>

            <div class="volunteer-status">

                ✓ You are volunteering
                for this project

            </div>

            <form
                action="/remove-volunteer/<%= project.project_id %>"
                method="POST">

                <button
                    type="submit"
                    class="remove-volunteer-btn">

                    Remove Volunteer Registration

                </button>

            </form>

        <% } %>

    </div>

<% } %>

        <div class="project-meta">

            <div class="meta-item">
                <span class="meta-label">Description</span>
                <p><%= project.description %></p>
            </div>

            <div class="meta-item">
                <span class="meta-label">Date</span>
                <p><%= new Date(project.date).toDateString() %></p>
            </div>

            <div class="meta-item">
                <span class="meta-label">Location</span>
                <p><%= project.location %></p>
            </div>

            <div class="meta-item">
                <span class="meta-label">Organization</span>
                <p>
                    <a href="/organization/<%= project.organization_id %>" class="org-link">
                        <%= project.organization_name %>
                    </a>
                </p>
            </div>

        </div>

        <div class="project-categories">
            <h3>Categories</h3>

            <div class="category-list">
                <% categories.forEach(cat => { %>
                    <a href="/category/<%= cat.category_id %>" class="category-badge">
                        <%= cat.category_name %>
                    </a>
                <% }) %>
            </div>
        </div>

    </div>

</main>

<%- include('partials/footer') %>