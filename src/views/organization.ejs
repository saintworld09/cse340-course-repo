<%- include('partials/header') %>
<div class="org-actions">
    <a
        href="/edit-organization/<%= organizationDetails.organization_id %>"
        class="edit-btn"
    >
        ✏️ Edit Organization
    </a>
</div>
<main>
    <h1><%= title %></h1>

    <h2>
        <%= organizationDetails.organization_name %>
    </h2>

    <img
        src="/images/<%= organizationDetails.logo_filename %>"
        alt="<%= organizationDetails.organization_name %> logo"
        width="150"
    >

    <p>
        <%= organizationDetails.organization_description %>
    </p>

    <p>
        Contact: <%= organizationDetails.contact_email %>
    </p>

    <h3>Service Projects</h3>

    <ul>
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
            <% }) %>
        <% } else { %>
            <li>No projects available for this organization.</li>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>