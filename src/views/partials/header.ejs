<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

<header class="site-header">

    <div class="logo-section">
        <a href="/" class="site-logo">
            Service Network
        </a>
    </div>

    <nav class="navbar">

        <!-- MAIN NAV LINKS -->
        <ul class="nav-links">

            <li>
                <a href="/" class="<%= activePage === 'home' ? 'active' : '' %>">
                    Home
                </a>
            </li>

            <li>
                <a href="/organizations" class="<%= activePage === 'organizations' ? 'active' : '' %>">
                    Organizations
                </a>
            </li>

            <li>
                <a href="/projects" class="<%= activePage === 'projects' ? 'active' : '' %>">
                    Projects
                </a>
            </li>

            <li>
                <a href="/categories" class="<%= activePage === 'categories' ? 'active' : '' %>">
                    Categories
                </a>
            </li>

        </ul>


        <!-- AUTH + ROLE LINKS -->
        <ul class="auth-links">

            <% if (isLoggedIn) { %>

                <!-- Dashboard always for logged-in users -->
                <li>
                    <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'active' : '' %>">
                        Dashboard
                    </a>
                </li>

                <!-- ADMIN ONLY LINKS -->
                <% if (user && user.role_name === 'admin') { %>
                    <li>
                        <a href="/new-organization">
                            Admin Panel
                        </a>
                    </li>
                <% } %>

                <!-- LOGOUT -->
                <li>
                    <a href="/logout" class="logout-btn">
                        Logout
                    </a>
                </li>

            <% } else { %>

                <!-- NOT LOGGED IN -->
                <li>
                    <a href="/register">
                        Register
                    </a>
                </li>

                <li>
                    <a href="/login" class="login-btn">
                        Login
                    </a>
                </li>

            <% } %>

        </ul>

    </nav>

</header>

<!-- FLASH MESSAGES -->
<% const messages = flash(); %>

<% Object.keys(messages).forEach(type => { %>
    <% if (messages[type].length > 0) { %>
        <% messages[type].forEach(msg => { %>
            <div class="alert <%= type %>">
                <%= msg %>
            </div>
        <% }) %>
    <% } %>
<% }) %>