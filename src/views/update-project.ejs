<%- include('partials/header') %>

<main class="form-page">

    <div class="form-card">

        <div class="form-header">
            <h1><%= title %></h1>
            <p>Update your service project information below.</p>
        </div>

        <form action="/edit-project/<%= project.project_id %>" method="POST">

            <div class="form-group">
                <label for="title">Project Title</label>

                <input
                    type="text"
                    id="title"
                    name="title"
                    value="<%= project.title %>"
                    required
                    maxlength="200"
                />
            </div>

            <div class="form-group">
                <label for="description">Description</label>

                <textarea
                    id="description"
                    name="description"
                    required
                    maxlength="1000"
                ><%= project.description %></textarea>
            </div>

            <div class="form-row">

                <div class="form-group">
                    <label for="location">Location</label>

                    <input
                        type="text"
                        id="location"
                        name="location"
                        value="<%= project.location %>"
                        required
                        maxlength="200"
                    />
                </div>

                <div class="form-group">
                    <label for="date">Project Date</label>

                    <input
                        type="date"
                        id="date"
                        name="date"
                        value="<%= new Date(project.date).toISOString().split('T')[0] %>"
                        required
                    />
                </div>

            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>

                <select name="organizationId" id="organizationId" required>

                    <% organizations.forEach(org => { %>

                        <option
                            value="<%= org.organization_id %>"
                            <%= org.organization_id === project.organization_id ? 'selected' : '' %>
                        >
                            <%= org.organization_name %>
                        </option>

                    <% }) %>

                </select>
            </div>

            <button type="submit" class="btn-submit">
                Update Project
            </button>

        </form>

    </div>

</main>

<%- include('partials/footer') %>