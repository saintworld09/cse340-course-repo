<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations:</p>

    <ul>
        <% organizations.forEach(organization => { %>

            <li>
                <img 
                    src="/images/<%= organization.logo_filename %>" 
                    alt="<%= organization.organization_name %> logo"
                    width="100"
                >

                <h2>
                    <a href="/organization/<%= organization.organization_id %>">
                        <%= organization.organization_name %>
                    </a>
                </h2>

                <p>
                    <%= organization.organization_description %>
                </p>

                <p>
                    Contact: <%= organization.contact_email %>
                </p>
            </li>

        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>