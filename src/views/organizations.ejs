<%- include('partials/header') %>

<main class="organizations-page">

    <div class="organizations-header">
        <div>
            <h1><%= title %></h1>
            <p class="organizations-subtitle">
                Here are a few of our partner organizations making a difference in communities.
            </p>
        </div>

        <a href="/new-organization" class="add-org-btn">
            + Add Organization
        </a>
    </div>

    <div class="organization-grid">

        <% if (organizations && organizations.length > 0) { %>

            <% organizations.forEach(organization => { %>
            <div class="organization-card">

                    <div class="organization-logo">
                        <img
                            src="/images/<%= organization.logo_filename %>"
                            alt="<%= organization.organization_name %> logo"
                        >
                    </div>

                    <div class="organization-content">
                        <h2>
                            <a href="/organization/<%= organization.organization_id %>">
                                <%= organization.organization_name %>
                            </a>
                        </h2>

                        <p class="organization-description">
                            <%= organization.organization_description %>
                        </p>

                        <div class="organization-contact">
                             <span>Email:</span>
                            <p><%= organization.contact_email %></p>
                        </div>
                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <p>No organizations found.</p>

        <% } %>

    </div>

</main>

<%- include('partials/footer') %>