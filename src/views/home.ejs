<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Welcome to the CSE 340 Service Network!</h2>

    <p>
        Our mission is to promote service across the world by connecting
        volunteers with service opportunities in their community.
    </p>

    <img
        class="main-logo"
        src="images/cse340-service-network.png"
        alt="CSE 340 Service Network Logo"
    >

    <% if (isLoggedIn) { %>

        <div class="dashboard-section">

            <h3>Welcome Back!</h3>

            <p>
                Access your dashboard to manage your account and view your information.
            </p>

            <a href="/dashboard" class="dashboard-btn">
                My Dashboard
            </a>

        </div>

    <% } %>

</main>

<%- include('partials/footer') %>